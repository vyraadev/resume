<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --ink: #1a1a2e;
    --soft: #4a4a6a;
    --muted: #8888aa;
    --accent: #c45c8a;
    --accent2: #7c6fcd;
    --bg: #faf9f7;
    --rule: #e8e4f0;
    --tag-bg: #f0edf8;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--ink);
    min-height: 100vh;
    padding: 40px 20px;
  }

  .page {
    max-width: 800px;
    margin: 0 auto;
    background: white;
    box-shadow: 0 4px 40px rgba(100,80,140,.10);
    border-radius: 2px;
    overflow: hidden;
    animation: fadeUp .6s ease both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* HEADER */
  .header {
    background: var(--ink);
    padding: 44px 52px 36px;
    position: relative;
    overflow: hidden;
  }

  .header::before {
    content: '';
    position: absolute;
    top: -60px; right: -60px;
    width: 220px; height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(196,92,138,.25) 0%, transparent 70%);
  }

  .header::after {
    content: '';
    position: absolute;
    bottom: -40px; left: 30%;
    width: 160px; height: 160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124,111,205,.2) 0%, transparent 70%);
  }

  .open-badge {
    display: inline-block;
    font-family: 'DM Sans', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #a8f5c8;
    background: rgba(168,245,200,.12);
    border: 1px solid rgba(168,245,200,.3);
    border-radius: 20px;
    padding: 4px 12px;
    margin-bottom: 18px;
  }

  .name {
    font-family: 'DM Serif Display', serif;
    font-size: 42px;
    color: white;
    line-height: 1.05;
    letter-spacing: -.02em;
    margin-bottom: 8px;
    position: relative;
  }

  .title-line {
    font-size: 13px;
    font-weight: 400;
    color: rgba(255,255,255,.55);
    letter-spacing: .04em;
    margin-bottom: 28px;
    position: relative;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    position: relative;
  }

  .contact-item {
    font-size: 12px;
    color: rgba(255,255,255,.7);
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .contact-item a {
    color: rgba(255,255,255,.7);
    text-decoration: none;
  }

  .contact-item a:hover { color: white; }

  .dot {
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
  }

  /* BODY */
  .body {
    padding: 44px 52px;
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 0 40px;
  }

  .main { }
  .sidebar { border-left: 1px solid var(--rule); padding-left: 32px; }

  /* SECTION */
  .section { margin-bottom: 36px; }

  .section-label {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  /* PROFILE */
  .profile-text {
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--soft);
  }

  .profile-text strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* EXPERIENCE */
  .job { margin-bottom: 24px; }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
    gap: 12px;
  }

  .job-title {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink);
  }

  .job-date {
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
    padding-top: 2px;
  }

  .job-company {
    font-size: 12px;
    color: var(--accent2);
    font-weight: 500;
    margin-bottom: 8px;
  }

  .job-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .job-bullets li {
    font-size: 12.5px;
    color: var(--soft);
    line-height: 1.6;
    padding-left: 14px;
    position: relative;
  }

  .job-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 5px;
    height: 1.5px;
    background: var(--accent);
    border-radius: 2px;
  }

  /* SIDEBAR */
  .sidebar-section { margin-bottom: 28px; }

  .sidebar-label {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }

  /* SKILLS */
  .skill-group { margin-bottom: 14px; }

  .skill-group-name {
    font-size: 10.5px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 6px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .tag {
    font-size: 10.5px;
    color: var(--soft);
    background: var(--tag-bg);
    padding: 3px 9px;
    border-radius: 3px;
    font-weight: 400;
  }

  .tag.tech {
    background: #eef0fb;
    color: var(--accent2);
  }

  /* EDUCATION */
  .edu-item { margin-bottom: 14px; }

  .edu-school {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink);
  }

  .edu-detail {
    font-size: 11.5px;
    color: var(--muted);
    line-height: 1.6;
  }

  /* LANGUAGES */
  .lang-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .lang-name {
    font-size: 12px;
    color: var(--soft);
  }

  .lang-level {
    font-size: 10px;
    color: var(--muted);
    text-align: right;
  }

  .lang-bar {
    width: 100%;
    height: 2px;
    background: var(--rule);
    border-radius: 2px;
    margin-top: 4px;
    margin-bottom: 8px;
  }

  .lang-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    border-radius: 2px;
  }

  /* TECH PROJECTS */
  .project { margin-bottom: 12px; }

  .project-name {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .project-desc {
    font-size: 11.5px;
    color: var(--soft);
    line-height: 1.6;
  }

  @media print {
    body { padding: 0; background: white; }
    .page { box-shadow: none; }
  }
</style>
